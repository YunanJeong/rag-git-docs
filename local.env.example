# 자기 PC 에서 로컬로 돌릴 때 쓰는 환경변수다. .env 로 복사해 수집할 곳과 수집용 토큰만 채우면 된다.
# 헬름 배포에서는 이 파일을 쓰지 않고 deploy/ 의 values 파일이 정한다.

# 수집 방식. api(md only, 보안 우선) 또는 clone(리포 전체와 이력). 고르는 이유는 README 에 있다
# 두 방식은 DOCS_DIR 을 같이 쓰지 못한다. 바꾸면 DOCS_DIR 도 다른 곳으로 바꾼다
COLLECT_MODE=api

# gitlab 또는 github
SOURCE=gitlab

GITLAB_URL=https://gitlab.com
GITLAB_GROUP=your-group
# 수집용 GitLab 토큰. 스코프는 read_api. COLLECT_MODE=clone 이어도 이 스코프로 clone 된다
# 예: GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_TOKEN=

GITHUB_OWNER=your-owner
# 수집용 GitHub 토큰. 비공개 리포면 Contents 읽기 권한이 필요하다
# 예: GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# 수집한 것을 둘 곳. clone 이면 예: $HOME/.rag-git-docs/repos
DOCS_DIR=$HOME/.rag-git-docs/docs
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Qdrant 별칭. Qdrant 하나를 여럿이 같이 쓰면 서로 다르게 준다
QDRANT_ALIAS=docs

# 검색 서버 인증. 로컬은 none(인증 없음)이고, SERVE_HOST 가 127.0.0.1 일 때만 뜬다
# 다른 PC 에서 붙게 하려면 token 으로 바꾸고 SERVE_HOST 를 0.0.0.0 으로 둔다
AUTH_MODE=none
SERVE_HOST=127.0.0.1
# AUTH_MODE=token 일 때만 쓴다. 토큰은 openssl rand -hex 32 로 만든다
# 예: SERVE_TOKEN=kim:3f9a0c...,lee:8c21d4...
SERVE_TOKEN=
