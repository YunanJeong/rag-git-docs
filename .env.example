# --- 수집 (collect.py) ---

# 어느 소스에서 모을지. gitlab | github
# 고른 소스의 변수만 있으면 된다 — 나머지는 안 읽는다
SOURCE=gitlab

# 제외할 리포. 쉼표로 구분한 리포 경로 (myorg/docs/handbook 형태)
EXCLUDE_REPOS=

# --- SOURCE=gitlab 일 때 ---

# 대상 그룹. 하위 그룹까지 포함된다
GITLAB_GROUP=your-group

# 그룹 액세스 토큰. 스코프 read_api + read_repository
# GitLab 16.0 부터 만료일이 필수이고 최대 365일이다
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# 자체 호스팅이면 바꾼다
GITLAB_URL=https://gitlab.com

# --- SOURCE=github 일 때 ---

# 대상 계정 또는 조직
GITHUB_OWNER=your-owner

# PAT. 공개 리포만 볼 거면 스코프 없이도 되지만 토큰 자체는 필요하다
# 인증 없이는 시간당 60회라 리포 몇 개에서 막힌다
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- 수집 대상이자 색인 대상 (collect.py 가 쓰고 index.py 가 읽는다) ---
DOCS_DIR=/var/lib/rag-git-docs/docs

# --- 색인·검색 (index.py, search.py) ---

# Qdrant 접속. docker 로 띄웠으면 그대로 두면 된다
# k3s 에 Helm 으로 띄웠으면 http://<노드 IP>:30633 으로 바꾼다
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

# 서버에 API 키를 켰을 때만 채운다. 비워 두면 키 없이 붙는다
QDRANT_API_KEY=

# 임베딩 모델. 색인과 검색이 같아야 한다
EMBED_MODEL=BAAI/bge-m3

# 검색 결과 개수
TOP_K=5
