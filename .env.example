# 문서를 가져올 곳. gitlab 또는 github
SOURCE=gitlab

# SOURCE=gitlab 일 때
# 토큰 스코프는 read_api 와 read_repository 가 필요하다
GITLAB_GROUP=your-group
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_URL=https://gitlab.com

# SOURCE=github 일 때
GITHUB_OWNER=your-owner
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 가져온 문서를 둘 디렉터리
DOCS_DIR=/var/lib/rag-git-docs/docs

# Qdrant 주소와 API 키. 키를 안 켰으면 비워 둔다
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 팀원이 검색 서버에 붙을 때 쓰는 토큰. 비어 있으면 서버가 뜨지 않는다
SERVE_TOKEN=
