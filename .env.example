
# 수집 방식. api(md only, 보안 우선) 또는 clone(리포 전체와 이력, PoC). 고르는 이유는 README 에 있다
# 두 방식은 DOCS_DIR 을 같이 쓰지 못한다. 바꾸면 DOCS_DIR 도 다른 곳으로 바꾼다
COLLECT_MODE=api

# gitlab 또는 github
SOURCE=gitlab

GITLAB_URL=https://gitlab.com
GITLAB_GROUP=your-group
# GitLab 토큰. 스코프는 read_api. COLLECT_MODE=clone 이어도 이 스코프로 clone 된다
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

GITHUB_OWNER=your-owner
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 아래는 로컬에서 돌릴 때만 쓴다. 헬름 배포에서는 deploy/ 의 values 파일이 정한다
# clone 이면 예: /var/lib/rag-git-docs/repos
DOCS_DIR=/var/lib/rag-git-docs/docs
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Qdrant 별칭. Qdrant 하나를 여럿이 같이 쓰면 서로 다르게 준다
QDRANT_ALIAS=docs

# 검색 서버 토큰. 비어 있으면 서버가 뜨지 않는다. 토큰은 openssl rand -hex 32 로 만든다
# 예: SERVE_TOKEN=kim:3f9a0c...,lee:8c21d4...
SERVE_TOKEN=me:change-me
