# gitlab 또는 github
SOURCE=gitlab

GITLAB_URL=https://gitlab.com
GITLAB_GROUP=your-group
# GitLab 토큰. 스코프는 read_api
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

GITHUB_OWNER=your-owner
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 아래는 로컬에서 돌릴 때만 쓴다. k3s 에서는 deploy/rag-git-docs.values.yaml 이 정한다
DOCS_DIR=/var/lib/rag-git-docs/docs
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 검색 서버 토큰. Claude Code 가 검색 서버에 붙을 때 쓴다. 비어 있으면 서버가 뜨지 않는다. openssl rand -hex 32 로 만든다
SERVE_TOKEN=
